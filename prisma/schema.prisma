generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  titleEn       String?
  repo          String
  demoUrl       String?
  description   String
  descriptionEn String?
  category      String
  tags          String   @default("[]")
  icon          String   @default("📦")
  featured      Boolean  @default(false)
  views         Int      @default(0)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleEn     String?
  excerpt     String
  excerptEn   String?
  content     String
  category    String
  icon        String   @default("📝")
  readTime    Int      @default(5)
  views       Int      @default(0)
  likes       Int      @default(0)
  publishedAt DateTime @default(now())
  demoUrl     String?
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Comment {
  id          String   @id @default(cuid())
  articleSlug String
  name        String
  body        String
  createdAt   DateTime @default(now())

  @@index([articleSlug, createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model SiteStat {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model RepoSnapshot {
  id          Int      @id @default(1)
  payloadJson String
  updatedAt   DateTime @updatedAt
}

model GithubSnapshot {
  id          Int      @id @default(1)
  payloadJson String
  updatedAt   DateTime @updatedAt
}

/// Repo → live demo URL discovered by the auto-sync job (Cloudflare Workers
/// custom domains matched against repo names). Keyed by LOWERCASED repo name.
model RepoDemo {
  repo      String   @id
  url       String
  source    String   @default("cloudflare")
  updatedAt DateTime @updatedAt
}

/// Per-repo live metadata refreshed by the auto-sync job (latest GitHub
/// release + weekly commit counts). Keyed by exact repo name.
model RepoMeta {
  repo           String    @id
  latestTag      String?
  latestTagAt    DateTime?
  commitActivity String    @default("[]")
  openIssues     Int       @default(0)
  fetchedAt      DateTime  @updatedAt
}

/// Health of one demo host, HEAD-pinged during the auto-sync run.
/// `host` is the bare hostname (e.g. luxe.imsoroush.ir).
model DemoHealth {
  host        String   @id
  ok          Boolean  @default(true)
  latencyMs   Int      @default(0)
  lastChecked DateTime @updatedAt
}

/// Fixed-window per-IP counters backing the public POST rate limiter.
/// `key` is "<bucket>:<ip>"; rows older than the cleanup horizon are pruned
/// lazily whenever a new window starts for a key.
model RateLimit {
  key         String
  windowStart Int
  count       Int

  @@id([key, windowStart])
}
