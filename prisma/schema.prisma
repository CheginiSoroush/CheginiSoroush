generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  titleEn       String?
  repo          String
  demoUrl       String?
  description   String
  descriptionEn String?
  category      String
  tags          String   @default("[]")
  icon          String   @default("📦")
  featured      Boolean  @default(false)
  views         Int      @default(0)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleEn     String?
  excerpt     String
  excerptEn   String?
  content     String
  category    String
  icon        String   @default("📝")
  readTime    Int      @default(5)
  views       Int      @default(0)
  likes       Int      @default(0)
  publishedAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Comment {
  id          String   @id @default(cuid())
  articleSlug String
  name        String
  body        String
  createdAt   DateTime @default(now())

  @@index([articleSlug, createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model SiteStat {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model RepoSnapshot {
  id          Int      @id @default(1)
  payloadJson String
  updatedAt   DateTime @updatedAt
}

model GithubSnapshot {
  id          Int      @id @default(1)
  payloadJson String
  updatedAt   DateTime @updatedAt
}
