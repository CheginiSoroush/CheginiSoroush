# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env & secrets
.env
.env.*
*.pem

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
server.log

# local databases (create with `bun run db:push`, seed via prisma scripts)
db/*.db
db/*.db-journal

# local dev & operations notes
worklog.md
tool-results/
agent-ctx/
local-*

# local infrastructure (sandbox gateway / dev helper scripts)
Caddyfile
.zscripts/
tests/
examples/

# generated assets pipeline (cover art is committed; the generator stays local)
scripts/gen-covers.ts
download/

# local tooling & scratch directories
/skills/
/test
/prompt
.claude

# cloudflare build artifacts
.open-next/
.wrangler/

# audit workspace & chat uploads (never part of the product)
/audit/
/upload/

# resume working sources (local only)
/resume/
